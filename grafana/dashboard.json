      "title": "LCP over time (p75)",
      "datasource": {
        "type": "loki",
        "uid": "${DS_LOKI}"
      },
      "gridPos": {
        "x": 0,
        "y": 27,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "${DS_LOKI}"
          },
          "refId": "A",
          "expr": "quantile_over_time(0.75, {app=\"calendar-wrapped\", kind=\"vitals\"} | json | lcp > 0 | unwrap lcp [$__interval]) by (app)",
