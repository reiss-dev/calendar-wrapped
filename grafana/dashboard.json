        "y": 22,
        "w": 6,
        "h": 5
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "${DS_LOKI}"
          },
          "refId": "A",
          "expr": "quantile_over_time(0.75, {app=\"calendar-wrapped\", kind=\"vitals\"} | json | cls > 0 | unwrap cls [$__range]) by (app)",
          "queryType": "instant"
        }
      ],
