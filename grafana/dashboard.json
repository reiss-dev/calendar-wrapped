          },
          "refId": "A",
          "expr": "quantile_over_time(0.75, {app=\"calendar-wrapped\", kind=\"vitals\"} | json | inp > 0 | unwrap inp [$__range]) by (app)",
          "queryType": "instant"
        }
      ],
      "description": "75th percentile of INP across page views. Google's 'good' threshold is 200 ms.",
      "fieldConfig": {
        "defaults": {
